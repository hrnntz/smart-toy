# Configuración de URL del Backend PandaAI
#
# Para desarrollo con emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
#
# Para desarrollo con simulador iOS o web:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
#
# Para teléfono físico en la misma red Wi-Fi:
# EXPO_PUBLIC_API_URL=http://TU_IP_LOCAL:3000/api
#
# Para backend en la nube (Render):
EXPO_PUBLIC_API_URL=https://smart-toy.onrender.com/api
